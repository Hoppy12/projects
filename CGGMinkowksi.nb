Cell[TextData[{
 "Now we drag the coordinates using ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["a", "TI"]], 
         OverscriptBox["\[Del]", "^"], "\[Tau]", "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "v^a\\hat\\nabla\\tau=1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "264dca37-bb24-4f9f-ac02-6b1b6e795c87"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["a", "TI"]], 
         OverscriptBox["\[Del]", "^"], 
         SuperscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "v^a\\hat\\nabla x^i=0", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bfcce285-6cbc-44d0-8954-c30f5548d5c5"],
 ". Since the coordinates are scalars we can use any connection."
}], "Text",
 CellChangeTimes->{{3.990141283149583*^9, 
  3.9901413442962847`*^9}},ExpressionUUID->"1a719616-e54b-4a76-948b-\
12c6e1ce4101"],

