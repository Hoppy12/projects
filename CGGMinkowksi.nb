Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DefChart", "[", 
    RowBox[{"mink", ",", "M", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x0", "[", "]"}], ",", 
       RowBox[{"x1", "[", "]"}], ",", 
       RowBox[{"x2", "[", "]"}], ",", 
       RowBox[{"x3", "[", "]"}]}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coordSub", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"x0", "[", "]"}], "->", 
      RowBox[{"t", "[", "s", "]"}]}], ",", 
     RowBox[{
      RowBox[{"x1", "[", "]"}], "->", 
      RowBox[{"r", "[", "s", "]"}]}], ",", 
     RowBox[{
      RowBox[{"x2", "[", "]"}], "->", "\[Theta]0"}], ",", 
     RowBox[{
      RowBox[{"x3", "[", "]"}], "->", "\[Phi]0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MetricInBasis", "[", 
   RowBox[{"g", ",", 
    RowBox[{"-", "mink"}], ",", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"x1", "[", "]"}], "^", "2"}]}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"x1", "[", "]"}], "^", "2"}]}], 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"x2", "[", "]"}], "]"}], "^", "2"}]}]}], "}"}], "]"}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MetricCompute", "[", 
    RowBox[{"g", ",", "mink", ",", "All"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gddC", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"ToCTensor", "[", 
      RowBox[{"g", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "mink"}], ",", 
         RowBox[{"-", "mink"}]}], "}"}]}], "]"}], "/.", 
     RowBox[{"TensorValues", "[", "g", "]"}]}], "/.", "coordSub"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"guuC", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"ToCTensor", "[", 
      RowBox[{"g", ",", 
       RowBox[{"{", 
        RowBox[{"mink", ",", "mink"}], "}"}]}], "]"}], "/.", 
     RowBox[{"TensorValues", "[", "g", "]"}]}], "/.", "coordSub"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalGamma]uddC", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"ToCTensor", "[", 
       RowBox[{"ChristoffelcdPDmink", ",", 
        RowBox[{"{", 
         RowBox[{"mink", ",", 
          RowBox[{"-", "mink"}], ",", 
          RowBox[{"-", "mink"}]}], "}"}]}], "]"}], "/.", 
      RowBox[{"TensorValues", "[", "ChristoffelcdPDmink", "]"}]}], "/.", 
     "coordSub"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ToCTensor", "[", 
     RowBox[{"ChristoffelcdPDmink", ",", 
      RowBox[{"{", 
       RowBox[{"mink", ",", 
        RowBox[{"-", "mink"}], ",", 
        RowBox[{"-", "mink"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"TensorValues", "[", "ChristoffelcdPDmink", "]"}]}], "/.", 
   "coordSub"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"d\[CapitalGamma]uddC", "=", 
    RowBox[{"Head", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ParamD", "[", "s", "]"}], "[", 
       RowBox[{"%", "[", 
        RowBox[{"a", ",", 
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "c"}]}], "]"}], "]"}], "/.", "paramDtoDSub"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tensorSub", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MakeRule", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{
           RowBox[{"-", "z1"}], ",", 
           RowBox[{"-", "z2"}]}], "]"}], ",", 
         RowBox[{"gddC", "[", 
          RowBox[{
           RowBox[{"-", "z1"}], ",", 
           RowBox[{"-", "z2"}]}], "]"}]}], "}"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"MakeRule", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{"z1", ",", "z2"}], "]"}], ",", 
         RowBox[{"guuC", "[", 
          RowBox[{"z1", ",", "z2"}], "]"}]}], "}"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"MakeRule", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Christoffelcd", "[", 
           RowBox[{"z1", ",", 
            RowBox[{"-", "z2"}], ",", 
