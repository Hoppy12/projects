Cell[CellGroupData[{

Cell["Choosing an Initial Surface", "Section",
 CellChangeTimes->{{3.99013446024107*^9, 
  3.990134468004163*^9}},ExpressionUUID->"380fcc37-6f2e-4aea-8ccd-\
777da2d8ea24"],

Cell[TextData[{
 "We define an initial surface ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "(", 
    RowBox[{
     SubscriptBox["t", "0"], ",", 
     SubscriptBox["r", "0"]}]}], TraditionalForm]],ExpressionUUID->
  "bd90edd0-60af-4163-acf9-7d9a4a571e72"],
 ")=0. The the normal vector to the surface is \[Del]G and we want the \
initial v to be proportional to this. It\[CloseCurlyQuote]s easier now to \
work in terms of the set of dr0, and initial \[Beta] values. Note the -ve \
sign on the spatial components of dG. We want ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["e", "0"], "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4030c546-0a06-4bb2-ac6a-7d70dabf93f0"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Del]", "a"], "G"}], "=", 
    RowBox[{
     SuperscriptBox["\[Eta]", "ab"], 
     RowBox[{
      SubscriptBox["\[Del]", "b"], "G"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c6939fd4-b8a2-41b8-84ce-6dadd591a542"],
 "."
}], "Text",
 CellChangeTimes->{{3.990141023090021*^9, 3.99014102953688*^9}, {
