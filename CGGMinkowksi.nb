        RowBox[{"u1", "[", "s", "]"}]}]}]}], "}"}], "/.", "uSol"}], "/.", 
   "\[Chi]Sol"}], "//", "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vSol", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"%", ",", 
     RowBox[{"D", "[", 
      RowBox[{"%", ",", "s"}], "]"}], ",", 
     RowBox[{"D", "[", 
