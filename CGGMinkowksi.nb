            RowBox[{"-", "z2"}], ",", 
            RowBox[{"-", "z3"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"MetricOn", "->", "All"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"MakeRule", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"d\[CapitalGamma]", "[", 
           RowBox[{"z1", ",", 
            RowBox[{"-", "z2"}], ",", 
            RowBox[{"-", "z3"}]}], "]"}], ",", 
          RowBox[{"d\[CapitalGamma]uddC", "[", 
