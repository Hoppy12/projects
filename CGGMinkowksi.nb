Cell[BoxData[{
 RowBox[{
  RowBox[{"Trig1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Cosh", "[", 
       RowBox[{"x__", "+", "y__"}], "]"}], "\[RuleDelayed]", 
      RowBox[{
       RowBox[{
        RowBox[{"Cosh", "[", "x", "]"}], 
        RowBox[{"Cosh", "[", "y", "]"}]}], "+", 
       RowBox[{
        RowBox[{"Sinh", "[", "x", "]"}], 
        RowBox[{"Sinh", "[", "y", "]"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"Sinh", "[", 
