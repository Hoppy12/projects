        RowBox[{"\[Beta]2", "[", "s", "]"}], ",", 
        RowBox[{"\[Beta]3", "[", "s", "]"}]}], "}"}]}], "]"}], "//", 
    "Simplify"}], "//", "Flatten"}]}]}], "Input",
