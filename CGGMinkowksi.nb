Cell[TextData[StyleBox["So far we have two free constants. These correspond \
to the angle of the initial velocity in the t-r plane and an initial covector \
value. We don\[CloseCurlyQuote]t get two values for the initial covector \
because we know it must satisfy a condition with \[Alpha] and u. This \
restricts us to two degrees of freedom.",
 FontColor->RGBColor[1., 1., 1.]]], "Text",
 CellChangeTimes->{{3.990741711888752*^9, 
  3.990741825564653*^9}},ExpressionUUID->"10ccc69e-e296-4798-a272-\
e6093c78c7b1"],

Cell[TextData[{
 "Now we solve the \[Chi] equation. We solve for an initially normalised ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["v", "a"], ","}], TraditionalForm]],ExpressionUUID->
  "4fd1cb11-460b-4a57-a3ec-13ed96269f69"],
 " that is, \[Chi][0]=1. It\[CloseCurlyQuote]s also handy to work with the \
initial derivative of \[Chi], so we define this here too."
}], "Text",
 CellChangeTimes->{{3.989351247855977*^9, 3.9893512548868217`*^9}, {
  3.9893515775981503`*^9, 3.989351601273806*^9}, {3.989352896945533*^9, 
  3.989352918738154*^9}},ExpressionUUID->"a118d086-83cc-42fe-a256-\
76801a19926d"],

Cell[CellGroupData[{

Cell[BoxData[{"dd\[CapitalChi]Eqn", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"%", "/.", "\[Alpha]Sub"}], "//", "CovDToChristoffel"}], "//", 
     "Expand"}], ")"}], "//.", "sDerivativeSub"}], "//.", "tensorSub"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "/.", "uSol"}], "//", "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"%", ",", 
      RowBox[{
       RowBox[{"\[Chi]", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
    RowBox[{"\[Chi]", "[", "s", "]"}], ",", "s"}], "]"}], "//", "Flatten"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Join", "[", 
   RowBox[{"%", ",", 
    RowBox[{"D", "[", 
     RowBox[{"%", ",", "s"}], "]"}], ",", 
    RowBox[{"D", "[", 
     RowBox[{"%", ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "2"}], "}"}]}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Chi]", "'"}], "[", "s", "]"}], "==", "d\[Chi]0"}], "/.", 
      "%"}], "/.", 
     RowBox[{"s", "->", "0"}]}], ",", 
    RowBox[{"C", "[", "1", "]"}]}], "]"}], "//", "Flatten"}], "\[IndentingNewLine]", 
 RowBox[{"d\[Chi]0Sub", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"C", "[", "1", "]"}], "==", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"C", "[", "1", "]"}], "/.", "%"}], ")"}]}], ",", "d\[Chi]0"}],
