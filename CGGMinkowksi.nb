      RowBox[{"u", "[", "a", "]"}], 
      RowBox[{"u", "[", "b", "]"}]}], "==", "1"}], "/.", "tensorSub"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"orth", "=", 
