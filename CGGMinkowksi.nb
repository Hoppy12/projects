          RowBox[{"-", "z2"}], ",", "z3"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"delta", "[", 
         RowBox[{
          RowBox[{"-", "z2"}], ",", "z4"}], "]"}], 
        RowBox[{"delta", "[", 
         RowBox[{
          RowBox[{"-", "z1"}], ",", "z3"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{
          RowBox[{"-", "z1"}], ",", 
          RowBox[{"-", "z2"}]}], "]"}], 
        RowBox[{"g", "[", 
         RowBox[{"z3", ",", "z4"}], "]"}]}]}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"weyl2LeviV", "=", 
