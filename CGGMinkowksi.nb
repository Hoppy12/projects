Cell[TextData[{
 "Now we substitute this expression into the second CGE equation. It makes \
sense to start from the second CGE equation as it describes the evolution of \
the covector, which essentially tells us the acceleration. We use the second \
CGE equation to eliminate \[Del]\[Beta] terms and use the above expression to \
turn \[Beta] terms into ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Alpha]", 
        StyleBox["a", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha^a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d271c55-69fe-4c7c-a5bd-1e2dc74627bc"],
 " terms."
}], "Text",
 CellChangeTimes->{
  3.989291028853348*^9},ExpressionUUID->"d6f2834b-673e-45f2-87c4-\
d7ed50630ad6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cd\[Beta]Sub", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"cd", "[", 
        RowBox[{"-", "z3"}], "]"}], "[", 
       RowBox[{"\[Beta]", "[", 
        RowBox[{"-", "z1"}], "]"}], "]"}], ",", 
      RowBox[{
       RowBox[{"cd", "[", 
        RowBox[{"-", "z3"}], "]"}], "[", 
       RowBox[{
        RowBox[{"\[Alpha]", "[", 
         RowBox[{"-", "z1"}], "]"}], "+", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"-", "z1"}], "]"}], 
         RowBox[{"u", "[", "z2", "]"}], 
         RowBox[{"\[Beta]", "[", 
          RowBox[{"-", "z2"}], "]"}]}]}], "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CGE2Sub", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"u", "[", "z1", "]"}], 
        RowBox[{
         RowBox[{"cd", "[", 
          RowBox[{"-", "z1"}], "]"}], "[", 
         RowBox[{"\[Beta]", "[", 
          RowBox[{"-", "z2"}], "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"u", "[", "z1", "]"}], 
         RowBox[{"\[Beta]", "[", 
          RowBox[{"-", "z1"}], "]"}], 
         RowBox[{"\[Beta]", "[", 
          RowBox[{"-", "z2"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], 
         RowBox[{"\[Beta]", "[", "z1", "]"}], 
         RowBox[{"\[Beta]", "[", 
          RowBox[{"-", "z1"}], "]"}], 
         RowBox[{"u", "[", 
          RowBox[{"-", "z2"}], "]"}]}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "->", "All"}], ",", 
     RowBox[{"ContractMetrics", "->", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]\[Beta]contraction", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Alpha]", "[", 
         RowBox[{"-", "z1"}], "]"}], 
        RowBox[{"\[Beta]", "[", "z1", "]"}]}], ",", 
       RowBox[{
        RowBox[{"\[Alpha]", "[", 
         RowBox[{"-", "z1"}], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Alpha]", "[", "z1", "]"}], "+", 
          RowBox[{
           RowBox[{"u", "[", "z1", "]"}], 
           RowBox[{"u", "[", "z2", "]"}], 
           RowBox[{"\[Beta]", "[", 
            RowBox[{"-", "z2"}], "]"}]}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "->", "All"}], ",", 
     RowBox[{"ContractMetrics", "->", "True"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "CGE2", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"%", "/.", "uSub"}], ")"}], "/", 
   RowBox[{
    RowBox[{"\[CapitalChi]", "[", "]"}], "^", "2"}]}], "//", 
  "ToCanonical"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "/.", "cd\[Beta]Sub"}], "//", "ToCanonical"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SameDummies", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"%", "/.", "CGE2Sub"}], "//", "ToCanonical"}], ")"}], "/.", 
     "uRules"}], "]"}], "/.", "\[Alpha]Def"}], "//", "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "/.", "\[Alpha]\[Beta]contraction"}], "//", "ToCanonical"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "/.", "uRules"}], "/.", 
  RowBox[{"MakeRule", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"u", "[", "z3", "]"}], 
      RowBox[{"\[Beta]", "[", 
       RowBox[{"-", "z3"}], "]"}], 
      RowBox[{"\[Alpha]", "[", 
       RowBox[{"-", "z1"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"u", "[", "z3", "]"}], 
      RowBox[{"\[Beta]", "[", 
       RowBox[{"-", "z3"}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Beta]", "[", 
         RowBox[{"-", "z1"}], "]"}], "-", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"-", "z1"}], "]"}], 
         RowBox[{"u", "[", "z2", "]"}], 
         RowBox[{"\[Beta]", "[", 
          RowBox[{"-", "z2"}], "]"}]}]}], ")"}]}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"CGE3", "=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"a", ",", "c"}], "]"}], "%"}], "//", "ToCanonical"}], "//", 
    "Simplify"}], ")"}]}]}], "Input",
