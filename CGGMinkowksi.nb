Cell[TextData[{
 "So we see that we do in fact have the conformal factor such that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalOmega]", "2"], 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "~"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], 
         SuperscriptBox[
          SubscriptBox[
           StyleBox["e", "TI"], 
           OverscriptBox[
            StyleBox["a", "TI"], "^"]], 
          StyleBox["a", "TI"]], 
         SuperscriptBox[
          SubscriptBox[
           StyleBox["e", "TI"], 
           OverscriptBox[
            StyleBox["b", "TI"], "^"]], 
          StyleBox["b", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Eta]", 
          RowBox[{
            OverscriptBox[
             StyleBox["a", "TI"], "^"], 
            OverscriptBox[
             StyleBox["b", "TI"], "^"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\Omega^2 \\tilde \
g_{ab}{e_{\\hat{a}}}^a{e_{\\hat{b}}}^b=\\eta_{\\hat{a}\\hat{b}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41eb72f6-c1fa-4c5c-b2eb-cb135ad29ff0"],
 ". Now we check that the third derivative is indeed 0."
}], "Text",
