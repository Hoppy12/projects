Cell[TextData[{
 "Now we define the CGEs, starting from Weyl transport with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox["\[Del]", "^"], 
          StyleBox["a", "TI"]], 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "~"], 
          RowBox[{
            StyleBox["b", "TI"], 
            StyleBox["c", "TI"]}]], "\[LongEqual]", "-2", 
         SubscriptBox["\[Beta]", 
          StyleBox["a", "TI"]], 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "~"], 
          RowBox[{
            StyleBox["b", "TI"], 
            StyleBox["c", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat{\\nabla}_a\\tilde{g}_{bc}=-2\\beta_a\\tilde{g}_{bc}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27db674a-d774-426f-a029-61c5c513f33d"],
 "."
}], "Text",
