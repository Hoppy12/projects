       RowBox[{"{", 
        RowBox[{"s", ",", "2"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "\[Alpha]\[Beta]Eqn", "\[IndentingNewLine]", 
