Cell[CellGroupData[{

Cell["Deriving the Third Order Formulation", "Section",
 CellChangeTimes->{{3.9877035644941397`*^9, 3.987703571844521*^9}, {
  3.98770370468217*^9, 
  3.987703711714007*^9}},ExpressionUUID->"555f17cf-8cec-415f-ab37-\
d564436fe638"],

Cell[TextData[{
 "Now we find the form of these equations in terms of the unit 4 velocity ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["a", "TI"]], "\[LongEqual]", 
         SuperscriptBox["\[Chi]", "-2"], 
         SuperscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["a", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "u^a=\\chi^{-2} v^a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "454cf63b-292b-4335-bbdc-61b2516e527a"],
 ". First we define rules for replacing ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["v", "TI"], 
        StyleBox["a", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "v^a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c2f4c778-6fba-4d95-88a1-dac5a96b6259"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["a", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "u^a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "431a1518-1ee5-4af2-94d2-95d5cbf7fd83"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Chi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\chi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3bd3d578-6998-4213-a4f1-225049068dcf"],
 "."
}], "Text",
 CellChangeTimes->{
  3.989290448879178*^9},ExpressionUUID->"73983910-c171-4dc8-aa43-\
ded00fd61c7e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"uSub", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"v", "[", "z1", "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalChi]", "[", "]"}], "^", "2"}], 
        RowBox[{"u", "[", "z1", "]"}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "->", "All"}], ",", 
     RowBox[{"ContractMetrics", "->", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vSub", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "[", "z1", "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalChi]", "[", "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"-", "2"}], ")"}]}], 
        RowBox[{"v", "[", "z1", "]"}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "->", "All"}], ",", 
     RowBox[{"ContractMetrics", "->", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]Def", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"u", "[", "z1", "]"}], 
        RowBox[{
         RowBox[{"cd", "[", 
          RowBox[{"-", "z1"}], "]"}], "[", 
         RowBox[{"u", "[", "z2", "]"}], "]"}]}], ",", 
       RowBox[{"\[Alpha]", "[", "z2", "]"}]}], "}"}], ",", 
     RowBox[{"MetricOn", "->", "All"}], ",", 
     RowBox[{"ContractMetrics", "->", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]Sub", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Alpha]", "[", "z2", "]"}], ",", 
       RowBox[{
        RowBox[{"u", "[", "z1", "]"}], 
        RowBox[{
         RowBox[{"cd", "[", 
          RowBox[{"-", "z1"}], "]"}], "[", 
         RowBox[{"u", "[", "z2", "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "->", "All"}], ",", 
     RowBox[{"ContractMetrics", "->", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uRules", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"MakeRule", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "z1", "]"}], 
          RowBox[{"u", "[", 
           RowBox[{"-", "z1"}], "]"}]}], ",", "1"}], "}"}], ",", 
       RowBox[{"MetricOn", "->", "All"}], ",", 
       RowBox[{"ContractMetrics", "->", "True"}]}], "]"}], ",", 
     RowBox[{"MakeRule", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Alpha]", "[", "z1", "]"}], 
          RowBox[{"u", "[", 
           RowBox[{"-", "z1"}], "]"}]}], ",", "0"}], "}"}], ",", 
       RowBox[{"MetricOn", "->", "All"}], ",", 
       RowBox[{"ContractMetrics", "->", "True"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CGE1", "/.", "uSub"}], "//", "ToCanonical"}], "\[IndentingNewLine]", 
 RowBox[{"\[Alpha]\[Chi]Eqn", "=", 
  RowBox[{
   RowBox[{"%", "/.", "\[Alpha]Def"}], "/.", "uRules"}]}]}], "Input",
 CellChangeTimes->{{3.9892905979234667`*^9, 3.9892906010932827`*^9}, {
  3.989349510085844*^9, 3.9893495202177773`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"ebc8c786-2ccc-4737-bbd0-11f4bbe3a433"],

