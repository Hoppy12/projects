Cell[TextData[{
 "We will define a 4 velocity ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["v", "TI"], 
        StyleBox["a", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "v^a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67b5ff6a-32a4-48a3-8c04-2ae2f2419f33"],
 " with a unit 4 velocity ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["a", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "u^a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7c05f54e-3669-45ea-9f45-dd722f984631"],
 " and length ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Chi]", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\chi^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "37e1b994-1d44-4d6b-8fd7-8d9aacf6628c"],
 " along with a covector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Beta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d697a7d-a9ad-49bb-b59d-237a13fb3a71"],
 ". The four acceleration will be denoted ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["v", "TI"]}], ")"}], 
        StyleBox["a", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "(av)^a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d82a854f-1367-4142-9ab4-aab3a2cc7ba5"],
 ". The acceleration of the unit velocity will be given by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["u", "TI"]}], ")"}], 
        StyleBox["a", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "(au)^a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b8d01e19-14dc-4b8f-ae1e-d9473448a5f4"],
 ". "
}], "Text",
