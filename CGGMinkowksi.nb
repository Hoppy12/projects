         RowBox[{"\[Beta]", "[", 
          RowBox[{"-", "z4"}], "]"}], 
         RowBox[{"F", "[", "z3", "]"}]}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "->", "All"}], ",", 
     RowBox[{"ContractMetrics", "->", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
