Cell[TextData[StyleBox["Show that the second equation is conformally \
invariant. IS IT THE ONLY POSSIBLE CONFORMALLY INVARIANT CONDITION ON \
\[Beta]????",
 FontColor->RGBColor[1., 0., 0.]]], "Text",
 CellChangeTimes->{{3.989290389713874*^9, 
  3.9892904216037273`*^9}},ExpressionUUID->"ee434cbe-4c78-4edf-9d86-\
5c31bfef9c62"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LHS1", "=", 
   RowBox[{
    RowBox[{"v", "[", "b", "]"}], 
    RowBox[{
     RowBox[{"cd", "[", 
      RowBox[{"-", "b"}], "]"}], "[", 
     RowBox[{"v", "[", "a", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RHS1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], 
     RowBox[{"\[Beta]", "[", 
      RowBox[{"-", "b"}], "]"}], 
     RowBox[{"v", "[", "b", "]"}], 
     RowBox[{"v", "[", "a", "]"}]}], "+", 
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"-", "b"}], "]"}], 
     RowBox[{"v", "[", "b", "]"}], 
     RowBox[{"\[Beta]", "[", "a", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LHS2", "=", 
   RowBox[{
    RowBox[{"v", "[", "b", "]"}], 
    RowBox[{
     RowBox[{"cd", "[", 
      RowBox[{"-", "b"}], "]"}], "[", 
     RowBox[{"\[Beta]", "[", 
      RowBox[{"-", "a"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RHS2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Beta]", "[", 
      RowBox[{"-", "b"}], "]"}], 
     RowBox[{"v", "[", "b", "]"}], 
     RowBox[{"\[Beta]", "[", 
      RowBox[{"-", "a"}], "]"}]}], "-", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"\[Beta]", "[", 
      RowBox[{"-", "b"}], "]"}], 
     RowBox[{"\[Beta]", "[", "b", "]"}], 
     RowBox[{"v", "[", 
      RowBox[{"-", "a"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"CGE1", "=", 
  RowBox[{"LHS1", "==", "RHS1"}]}], "\[IndentingNewLine]", 
 RowBox[{"CGE2", "=", 
  RowBox[{"LHS2", "==", "RHS2"}]}]}], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"bd78cc59-f06c-4912-b0a4-0af5946b768b"],

