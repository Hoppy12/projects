 RowBox[{
  RowBox[{"weyl2LeviF", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"wc", "[", 
