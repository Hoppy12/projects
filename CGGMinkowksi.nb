  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"%", "/.", "\[Alpha]Sub"}], "//", "CovDToChristoffel"}], "//",
        "Expand"}], ")"}], "/.", "sDerivativeSub"}], "//.", "tensorSub"}], "/.",
    "uSol"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]system", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Basis", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"{", 
          RowBox[{"IND", ",", "mink"}], "}"}]}], "]"}], "%"}], "//", 
      "ContractBasis"}], ",", 
     RowBox[{"{", 
      RowBox[{"IND", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{"\[Beta]123Sol", "=", 
  RowBox[{
   RowBox[{
