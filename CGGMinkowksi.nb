Cell[TextData[{
 "Solving the first system should give us back ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", "a"], TraditionalForm]],ExpressionUUID->
  "be026252-0aa7-477a-96a2-0d8e62cd7877"],
 ". Note the constants of integration C[2] and C[3] introduced here are \
different for all of the frame components and different to the C[2] which \
appears above. We need to be careful when substituting initial conditions. \
This time vector computation is just to check our method. We already know it \
should be ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e04575cc-598e-4502-9d14-2ec6a68804d1"],
 ". On the last line we substract the solutions to check we are right."
}], "Text",
 CellChangeTimes->{{3.989444669128509*^9, 3.989444687856851*^9}, {
