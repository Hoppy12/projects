Cell[TextData[{
 "We must also derive an equation for the length \[Chi] of the 4 velocity, \
otherwise we cannot properly integrate to obtain the curve. To remove the \
covector from the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox["\[Chi]", "."], TraditionalForm], "errors" -> {}, 
     "input" -> "\\dot\\chi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d4a23f3-60ec-410f-8b1b-b77c0cde49ef"],
 " equation, we must differentiate again. The key final step is replacing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "a"], 
    SuperscriptBox["\[Beta]", "a"]}], TraditionalForm]],ExpressionUUID->
  "baca5801-157d-456c-96d2-56fe92efcc6a"],
 " with a form where each \[Beta] is replaced with \[Beta]Substitution. "
}], "Text",
 CellChangeTimes->{
  3.989291246039486*^9},ExpressionUUID->"a7a2e557-1a03-4698-bb94-\
00d7036090a4"],

Cell[CellGroupData[{

Cell[BoxData[{"\[CapitalChi]DotEqn", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", "c", "]"}], 
    RowBox[{
     RowBox[{"cd", "[", 
      RowBox[{"-", "c"}], "]"}], "[", 
     RowBox[{"%", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "==", 
   RowBox[{
    RowBox[{"u", "[", "c", "]"}], 
    RowBox[{
     RowBox[{"cd", "[", 
      RowBox[{"-", "c"}], "]"}], "[", 
     RowBox[{"%", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "//", "ToCanonical"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"%", "/.", "CGE2Sub"}], "/.", "\[Alpha]Def"}], "//", 
       "ToCanonical"}], "//", "CovDToChristoffel"}], ")"}], "/.", 
    "sDerivativeSub"}], "/.", "\[CapitalChi]DotSub"}], "/.", "uRules"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"%", "/.", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Beta]", "[", 
          RowBox[{"-", "z1"}], "]"}], 
         RowBox[{"\[Beta]", "[", "z1", "]"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Alpha]", "[", 
            RowBox[{"-", "z1"}], "]"}], "+", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"-", "z1"}], "]"}], 
            RowBox[{"u", "[", "z2", "]"}], 
            RowBox[{"\[Beta]", "[", 
             RowBox[{"-", "z2"}], "]"}]}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Alpha]", "[", "z1", "]"}], "+", 
           RowBox[{
            RowBox[{"u", "[", "z1", "]"}], 
            RowBox[{"u", "[", "z3", "]"}], 
            RowBox[{"\[Beta]", "[", 
             RowBox[{"-", "z3"}], "]"}]}]}], ")"}]}]}], "}"}], "]"}]}], "//", 
    "ToCanonical"}], ")"}], "/.", "uRules"}], "\[IndentingNewLine]", 
 RowBox[{"dd\[CapitalChi]Eqn", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"%", "/.", 
      RowBox[{"MakeRule", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Alpha]", "[", "z1", "]"}], 
          RowBox[{"\[Beta]", "[", 
           RowBox[{"-", "z1"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[Alpha]", "[", "z1", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Alpha]", "[", 
             RowBox[{"-", "z1"}], "]"}], "+", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"-", "z1"}], "]"}], 
             RowBox[{"u", "[", "z2", "]"}], 
             RowBox[{"\[Beta]", "[", 
              RowBox[{"-", "z2"}], "]"}]}]}], ")"}]}]}], "}"}], "]"}]}], "//",
      "ToCanonical"}], ")"}], "/.", "uRules"}]}]}], "Input",
